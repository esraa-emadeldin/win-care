{
  "name": "win-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite ui",
    "build:ui": "vue-tsc -p ui --noEmit && vite build ui",
    "tauri": "tauri",
    "typecheck": "vue-tsc -p ui --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --root ui",
    "test:e2e": "playwright test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check": "npm run check:rust && npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "prepare": "simple-git-hooks",
    "design:compare": "playwright test -c playwright.design.config.ts compare",
    "design:check": "playwright test -c playwright.design.config.ts visual"
  },
  "simple-git-hooks": {
    "pre-commit": "cargo fmt --all --check && npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,html,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.347",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "d3-hierarchy": "^3.1.3",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  }
}
