{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "win-care",
  "version": "0.1.0",
  "identifier": "dev.wincare.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "win-care",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "tray",
        "title": "win-care",
        "url": "index.html#/tray",
        "width": 360,
        "height": 470,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "win-care contributors",
    "shortDescription": "Keep your Windows PC clean, from the tray."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RDRBN0JEQThGMjU2MzQKUldRMFZ2S292YWZVMTd5TlJraHRaVElKcXVaS3p3WEVCYzY1REdEN3AxOFJZV1YzaTYrb240M1QK",
      "endpoints": [
        "https://github.com/esraa-emadeldin/win-care/releases/latest/download/latest.json"
      ]
    }
  }
}
